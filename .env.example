# ─────────────────────────────────────────────────────────────
# T.A.L.O.S. environment template
# Copy to `.env.local` and fill in the values marked (required).
# Prisma CLI reads `DATABASE_URL` from `.env` (see prisma7.config.ts).
# Next.js reads `.env.local` at runtime for everything else.
# ─────────────────────────────────────────────────────────────

# SQLite database (also used by the prisma CLI)
DATABASE_URL="file:./dev.db"

# TypeSafe Jev API (System One) — required
# Get a key at https://typesafe.ai
TYPESAFE_API_KEY=""

# Local Ollama (System Two)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# Routing gate: accept Jev's decision only above this confidence (0-1)
JEV_CONFIDENCE_THRESHOLD="0.85"